{
  "name": "warden",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "A policy and observability gateway for Model Context Protocol servers.",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @warden/gateway dev",
    "dashboard": "pnpm --filter @warden/dashboard dev",
    "db:setup": "pnpm --filter @warden/gateway db:setup",
    "keys": "pnpm --filter @warden/gateway keys",
    "test": "pnpm --filter @warden/gateway test",
    "test:integration": "pnpm --filter @warden/gateway test:integration",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "infra:up": "docker compose up -d mongo dynamodb",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs -f",
    "app": "docker compose --profile app up --build -d",
    "app:down": "docker compose --profile app down",
    "app:logs": "docker compose --profile app logs -f gateway"
  },
  "devDependencies": {
    "typescript": "^5.7.2"
  }
}

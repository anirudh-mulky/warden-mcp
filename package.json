{
  "name": "warden",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "A policy and observability gateway for Model Context Protocol servers.",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @warden/gateway dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs -f"
  },
  "devDependencies": {
    "typescript": "^5.7.2"
  }
}

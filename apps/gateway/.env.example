# Copy to .env and fill in. .env is gitignored — never commit real values.
NODE_ENV=development
PORT=8080
LOG_LEVEL=debug

# Development only: a fixed API key seeded into the in-memory key store at
# boot. Generate one with:
#   pnpm --filter @warden/gateway exec tsx -e 'import { generateApiKey } from "./src/auth/keys.ts"; console.log(generateApiKey().key)'
# WARDEN_DEV_API_KEY=wdn_...

# Optional: require this code to create a dashboard account.
# SIGNUP_CODE=at-least-8-chars

# Local Docker services (Day 1 sets these up but nothing uses them yet)
MONGODB_URI=mongodb://localhost:27017/warden
DYNAMODB_ENDPOINT=http://localhost:8000

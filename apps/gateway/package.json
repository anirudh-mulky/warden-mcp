{
  "name": "@warden/gateway",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "NODE_ENV=test LOG_LEVEL=fatal tsx --test \"src/**/*.test.ts\"",
    "test:integration": "NODE_ENV=test LOG_LEVEL=fatal ALLOW_PRIVATE_NETWORK_TARGETS=true APPROVAL_TIMEOUT_MS=3000 RATE_LIMIT_AUTH_BY_IP=false tsx --env-file-if-exists=.env --test --test-concurrency=1 \"src/**/*.itest.ts\"",
    "db:setup": "tsx --env-file-if-exists=.env src/scripts/create-tables.ts",
    "keys": "tsx --env-file-if-exists=.env src/scripts/keys.ts",
    "bench": "LOG_LEVEL=warn tsx --env-file-if-exists=.env src/scripts/bench.ts"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1151.0",
    "@aws-sdk/lib-dynamodb": "^3.1151.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@modelcontextprotocol/server-everything": "^2026.8.31",
    "@modelcontextprotocol/server-filesystem": "^2026.8.31",
    "@warden/shared": "workspace:*",
    "express": "^5.1.0",
    "jose": "^6.2.0",
    "mongodb": "^6.10.0",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
